{
	"name": "@sigrun/provider-typesafe",
	"version": "0.2.0",
	"description": "Sigrun provider plugin: TypeSafe (Jev) as a decision provider",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"test": "node scripts/check-manifest.mjs --expect-name @sigrun/provider-typesafe && vitest run",
		"typecheck": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"prepare": "npm run build"
	},
	"dependencies": {
		"pi-typesafe": "^0.14.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-durable": "1.5.0",
		"@sigrun/sigrun": "file:../sigrun",
		"@types/node": "^26.6.4",
		"typebox": "1.3.27",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"license": "MIT",
	"repository": {
		"type": "github",
		"url": "git+https://github.com/sigrun-ai/sigrun-provider-typesafe.git"
	},
	"bugs": {
		"url": "https://github.com/sigrun-ai/sigrun-provider-typesafe/issues"
	},
	"homepage": "https://github.com/sigrun-ai/sigrun-provider-typesafe#readme",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "~1.5.0",
		"@earendil-works/pi-durable": "~1.5.0",
		"@sigrun/sigrun": ">=0.15.0",
		"typebox": "1.3.27"
	}
}
